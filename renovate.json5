{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)",
    "github>DevSecNinja/.github//.renovate/autoMerge.json5",
    "github>DevSecNinja/.github//.renovate/base.json5",
    "github>DevSecNinja/.github//.renovate/customManagers.json5",
    "github>DevSecNinja/.github//.renovate/groups.json5",
    "github>DevSecNinja/.github//.renovate/labels.json5",
    "github>DevSecNinja/.github//.renovate/packageRules.json5",
    "github>DevSecNinja/.github//.renovate/semanticCommits.json5",
  ],
  packageRules: [
    {
      description: "Keep native macOS HA development reproducible until Python 3.15 dependencies are ready",
      matchManagers: ["mise", "pep621"],
      matchDepNames: ["python"],
      allowedVersions: "<3.15",
    },
    {
      description: "Update the exact minimum HA fixture only with the supported floor",
      matchManagers: ["pep621"],
      matchFileNames: ["pyproject.toml"],
      matchPackageNames: ["pytest-homeassistant-custom-component"],
      matchDepTypes: ["dependency-groups"],
      matchJsonata: ["managerData.depGroup = 'minimum'"],
      enabled: false,
    },
  ],
}
